# Copy to .env.docker; pass explicitly with docker compose --env-file .env.docker.
# Compose interpolation does not inject arbitrary variables: compose.yaml maps them.
COMPOSE_PROJECT_NAME=ai-companion-local
APP_PORT=8088
DB_NAME=companion_local
DB_USERNAME=companion
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
AI_PROVIDER=openai-compatible
AI_MOCK_ENABLED=false
AI_API_URL=https://your-provider.example/v1/chat/completions
AI_MODEL_NAME=your_enabled_model
AI_API_KEY=
AI_MAX_TOKENS=1024
# Optional; core chat does not require image generation.
ZHIPU_IMAGE_API_KEY=
