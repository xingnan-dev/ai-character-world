# Configuration reference only. Spring Boot and Vite do NOT load this file automatically.
# Set these in the backend process environment; see docs/LOCAL_RUN.md.
# Docker Compose uses the separate .env.docker.example; see docs/DOCKER_LOCAL.md.
SPRING_PROFILES_ACTIVE=local-real
DB_URL=jdbc:mysql://127.0.0.1:3307/companion_local?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=your_local_mysql_user
DB_PASSWORD=
JWT_SECRET=
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
AI_PROVIDER=openai-compatible
AI_MOCK_ENABLED=false
AI_API_URL=https://your-provider.example/v1/chat/completions
AI_MODEL_NAME=your_enabled_model
AI_API_KEY=
# Optional. Default is 1024; not a total budget for chat post-processing calls.
AI_MAX_TOKENS=1024
# Optional image integration; not needed for character/chat/World/read-only Agent.
ZHIPU_IMAGE_API_KEY=
# Optional absolute path. Default ./generated-images is relative to backend process cwd.
# IMAGE_STORAGE_DIRECTORY=
